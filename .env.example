NODE_ENV=dev
PORT=3333

# Database configuration
DATABASE_URL="postgresql://user:password@localhost:5432/carrin_db?schema=public"

# Authentication
# Secret used to sign JWT tokens. MUST be a strong, random string in production.
JWT_SECRET="super-secret-key-change-me-in-production"

# Expiration time for JWT tokens (e.g., 1d, 7d, 1h)
JWT_EXPIRES_IN="7d"
